# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PUBLIC_MENU_URL: Canonical public HTTPS URL encoded into generated Restaurant Menu & Order QR codes.
# Leave empty to automatically infer from APP_URL or the active request host.
PUBLIC_MENU_URL=""

# Session signing secret (generate a long random string in production)
SESSION_SECRET="replace-with-a-secure-random-secret"

# Initial / Production Admin Credentials (optional: if omitted, /admin/login prompts for one-time initial admin setup)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
